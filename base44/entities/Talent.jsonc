      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05db\u05e9\u05e8\u05d5\u05df"
    },
    "instagram_handle": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05d9\u05e0\u05e1\u05d8\u05d2\u05e8\u05dd \u05dc\u05dc\u05d0 @"
    },
    "tiktok_handle": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d8\u05d9\u05e7\u05d8\u05d5\u05e7 \u05dc\u05dc\u05d0 @"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u05d9\u05d5\u05e6\u05e8_\u05ea\u05d5\u05db\u05df",
        "\u05de\u05e9\u05e4\u05d9\u05e2\u05e0\u05d9\u05ea",
        "\u05db\u05e9\u05e8\u05d5\u05df",
        "\u05d0\u05de\u05e0\u05d9\u05ea"
