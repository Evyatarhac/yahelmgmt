      "default": "\u05d9\u05d5\u05e6\u05e8_\u05ea\u05d5\u05db\u05df",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05db\u05e9\u05e8\u05d5\u05df"
    },
    "bio": {
      "type": "string",
      "description": "\u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05d0\u05d5 \u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "profile_image_url": {
      "type": "string",
      "description": "URL \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc"
    },
    "show_booking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d6\u05de\u05e0\u05ea \u05d4\u05d5\u05e4\u05e2\u05d4"
    },
    "press_kit_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 Press Kit"
    },
    "booking_phone_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d4\u05d6\u05de\u05e0\u05ea \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea"
    }
